<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Acme.Sistemas.Atena.Mobile.Views"
       x:Class="Acme.Sistemas.Atena.Mobile.AppShell"
       Shell.FlyoutBehavior="Flyout"
       Shell.NavBarHasShadow="True"
       Title="Atena">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="120" BackgroundColor="{StaticResource Primary}">
            <Label Text="Atena Mobile"
                   FontSize="22"
                   TextColor="{StaticResource OnPrimary}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <ShellContent Title="Início" Icon="home.png"
                  Route="home"
                  ContentTemplate="{DataTemplate views:HomePage}" />

    <ShellContent Title="Espelho mensal" Icon="calendar.png"
                  Route="espelho"
                  ContentTemplate="{DataTemplate views:EspelhoMensalPage}" />

    <ShellContent Title="Meus ajustes" Icon="edit.png"
                  Route="ajustes"
                  ContentTemplate="{DataTemplate views:AjustesPage}" />

    <ShellContent Title="Configurações" Icon="settings.png"
                  Route="configuracoes"
                  ContentTemplate="{DataTemplate views:ConfiguracoesPage}" />

</Shell>
