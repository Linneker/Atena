<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Acme.Sistemas.Atena.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1d4ed8</Color>
            <Color x:Key="PrimaryDark">#1e40af</Color>
            <Color x:Key="Background">#f9fafb</Color>
            <Color x:Key="Surface">#ffffff</Color>
            <Color x:Key="OnPrimary">#ffffff</Color>
            <Color x:Key="OnBackground">#111827</Color>
            <Color x:Key="Success">#16a34a</Color>
            <Color x:Key="Danger">#dc2626</Color>
            <Color x:Key="Warning">#ea580c</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
