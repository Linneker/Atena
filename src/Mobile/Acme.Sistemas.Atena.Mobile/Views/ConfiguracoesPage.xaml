<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acme.Sistemas.Atena.Mobile.ViewModels"
             x:Class="Acme.Sistemas.Atena.Mobile.Views.ConfiguracoesPage"
             x:DataType="vm:ConfiguracoesViewModel"
             Title="Configurações">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Dispositivo" FontAttributes="Bold" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
            <Label Grid.Row="0" Grid.Column="0" Text="App version:" />
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" />
            <Label Grid.Row="1" Grid.Column="0" Text="OS version:" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding OsVersion}" />
            <Label Grid.Row="2" Grid.Column="0" Text="Plataforma:" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Plataforma}" />
            <Label Grid.Row="3" Grid.Column="0" Text="Modelo:" />
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Modelo}" />
        </Grid>

        <BoxView HeightRequest="1" BackgroundColor="#eee" />

        <Button Text="Sair" Command="{Binding LogoutCommand}"
                BackgroundColor="{StaticResource Danger}" TextColor="White" />
    </VerticalStackLayout>
</ContentPage>
